:8080 {
  respond /healthz 200

  @backend path_regexp ^/(api|sse|messages|mcp|docs|redoc|openapi\.json|\.well-known|oauth2)
	reverse_proxy @backend backend:8080

  reverse_proxy /jaeger/* jaeger:16686

  reverse_proxy * web:8080
}

{$SITE_ADDRESS} {
  reverse_proxy :8080
}
