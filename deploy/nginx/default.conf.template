map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80;

  resolver 127.0.0.11 valid=3s;
  resolver_timeout 2s;

  set $upstream_web http://web:8080;
  set $upstream_backend http://backend:8080;
  set $upstream_jaeger http://jaeger:16686;

  proxy_set_header Host $http_host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;

  proxy_set_header Origin $http_origin;

  proxy_set_header CF-Connecting-IP $http_cf_connecting_ip;
  proxy_set_header CF-Connecting-IPv6 $http_cf_connecting_ipv6;
  proxy_set_header CF-Ray $http_cf_ray;
  proxy_set_header CF-IPCountry $http_cf_ipcountry;
  proxy_set_header CF-Visitor $http_cf_visitor;

  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection $connection_upgrade;

  location /healthz { return 200; }
  location ~ ^/(api|sse|messages|mcp|docs|redoc|openapi\.json|\.well-known|oauth2) { proxy_pass $upstream_backend; }
  location /jaeger/ { proxy_pass $upstream_jaeger; }
  location / { proxy_pass $upstream_web; }
}
