# Gateway. 8080 = a non-privileged local-dev port (Caddy publishes HTTP on it).
# Prod sets this to 80 (and EXTERNAL_HTTPS_PORT=443) — see .env.prod.example.
EXTERNAL_HTTP_PORT=8080
EXTERNAL_POSTGRES_PORT=5432

# Database
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_HOST=postgres

# AI backend — leave empty to run degraded without AI features
OPENROUTER_API_KEY=

# Logs — level for the stdout event stream (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

