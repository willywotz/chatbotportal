# ──────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local dev. Every var has a default in code
# (backend/app/config.py + compose.yaml), so .env can be empty; set only what
# you want to override. Prod .env is generated by .github/workflows/release.yaml
# from secrets — no real secrets belong in this file.
#
# Vars are sorted by how likely you must set them, and tagged:
#   [SET IN PROD]  default is dev-only or empty; production MUST override.
#                  (dev runs fine without touching these.)
#   [SET IF NEEDED] default works in dev and prod; set when you want non-default
#                  behavior (dev AI features, a different port, etc.).
#   [OPTIONAL]     tuning knob with a sane default; leave it unless you have a
#                  specific reason.
# ──────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════
# [SET IN PROD] — production must override; dev works as-is.
# ══════════════════════════════════════════════════════════════════════════

# development | production. No code path enforces ENV; it is a passive label
# for logging/telemetry. CORS is wide-open by design (see CORS_ORIGINS).
ENV=development

# The only DB var the Python app reads. Default points at the compose postgres
# service. Prod: override with real credentials.
DATABASE_URL=postgres://chatbot:chatbot_secret@postgres:5432/chatbot

# JSON array. Default ["*"]: CORS is wide-open by design (allow_credentials=True
# reflects any origin). Cross-site exposure is mitigated by SameSite=Lax session
# cookies (browsers do not attach them to cross-site XHR) and header-only API keys.
# Set an explicit list like ["https://chatbotportal.opdc.ai.in.th"] to restrict.
CORS_ORIGINS=["*"]

# prod: set a real key. Empty = degraded mode (no AI features).
OPENROUTER_API_KEY=

# prod: override both. Defaults point at hardcoded staging IPs.
ONECHAT_BASE_URL=http://185.84.160.55:8000
MCP_ENDPOINT_URL=http://185.84.161.145/mcp/

# prod: set if parse-spec is used.
PARSE_SPEC_API_KEY=

# Public hostname for TLS. Empty = plain HTTP (local dev). Prod: your domain,
# e.g. chatbotportal.opdc.ai.in.th — Caddy auto-issues the cert.
CERT_DOMAIN=

# Let's Encrypt account contact for expiry notices. Prod: set a real email.
CERT_EMAIL=

# ══════════════════════════════════════════════════════════════════════════
# [SET IF NEEDED] — default works; set for non-default behavior.
# ══════════════════════════════════════════════════════════════════════════

# ── Gateway (compose caddy service) ───────────────────────────────────────
# 8080 = non-privileged local-dev port. Prod: 80 (Let's Encrypt HTTP-01 needs 80).
EXTERNAL_HTTP_PORT=8080
# Prod: 443. Dev is plain HTTP (CERT_DOMAIN unset), so unused locally.
EXTERNAL_HTTPS_PORT=
# Publish postgres on the host for local tooling. Prod: 5432 (or unset to hide).
EXTERNAL_POSTGRES_PORT=5432

# ── Database (compose postgres service) ────────────────────────────────────
# These build DATABASE_URL in compose.yaml:47. The backend reads only
# DATABASE_URL (above), not these four. Change if you want non-default creds.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_HOST=postgres

# ── Frontend (Vite, build-time) ────────────────────────────────────────────
# Base URL of the backend API. Empty = same-origin (Caddy proxies /api).
# Note: Vite inlines VITE_* at BUILD time, so this only affects the dev server
# (compose.override.yaml) — the prod static bundle always uses same-origin.
VITE_API_BASE_URL=
# "true" enables MSW request mocking (dev/test only).
VITE_USE_MOCKS=

# ── App ────────────────────────────────────────────────────────────────────
APP_NAME=AI Chatbot Portal API
APP_VERSION=1.0.0
TIMEZONE=Asia/Bangkok
USER_AGENT_PREFIX=AI-Chatbot-Portal/1.0
# DEBUG | INFO | WARNING | ERROR. 15-Factor XI: stdout event-stream level.
LOG_LEVEL=INFO

# ── LLM / OpenRouter ───────────────────────────────────────────────────────
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
CLASSIFICATION_MODEL=google/gemini-2.5-flash-lite

# ── Parse spec (ThaiLLM) ───────────────────────────────────────────────────
PARSE_SPEC_URL=http://thaillm.or.th/api/openthaigpt/v1/chat/completions
PARSE_SPEC_LLM_MODEL=/model

# ── Uploads ────────────────────────────────────────────────────────────────
# On-disk upload root (named volume in compose, backend service only). Agency
# logos live under {UPLOAD_DIR}/agency-logos/.
UPLOAD_DIR=/app/uploads

# ── Auth ───────────────────────────────────────────────────────────────────
# Auth is session-cookie based (JWT was removed).
MIN_PASSWORD_LENGTH=6
AUTH_COOKIE_SECURE=true

# ══════════════════════════════════════════════════════════════════════════
# [OPTIONAL] — tuning knobs with sane defaults; leave unless you have a reason.
# ══════════════════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────────────────
# Domain-event outbox dispatcher tick interval (seconds).
EVENT_DISPATCH_INTERVAL_SECONDS=10

# ── Database pool ──────────────────────────────────────────────────────────
DB_POOL_MIN=1
DB_POOL_MAX=10

# ── Session cookie auth ────────────────────────────────────────────────────
# All times in minutes/seconds.
SESSION_COOKIE_NAME=session_id
SESSION_TTL_MINUTES=10080
SESSION_REFRESH_BELOW_MINUTES=4320
SESSION_ROTATE_GRACE_SECONDS=60

# ── LLM / OpenRouter ───────────────────────────────────────────────────────
LLM_CALL_TIMEOUT=60.0

# ── Parse spec (ThaiLLM) ───────────────────────────────────────────────────
PARSE_SPEC_TIMEOUT=60

# ── OneChat endpoints ──────────────────────────────────────────────────────
# Query string appended to agent-proxy endpoint_url to probe OneChat query-string
# preservation (empty = off).
TRACE_URL_PROBE=

# ── Chat ───────────────────────────────────────────────────────────────────
A2A_DISPATCH_TIMEOUT=30
V4_STREAM_TIMEOUT=300.0
EXTERNAL_CHAT_TIMEOUT=180.0
TITLE_MAX_LENGTH=50
PREVIEW_MAX_LENGTH=100
SPEC_TEXT_MAX_CHARS=30000
RESPONSES_WS_MAX_CONNECTIONS=1024
RESPONSES_WS_MAX_DURATION_SECONDS=900
CHAT_WS_MAX_CONNECTIONS=1024
CHAT_WS_MAX_DURATION_SECONDS=900

# ── Agency health / scheduler ──────────────────────────────────────────────
AGENCY_CHAT_TIMEOUT=180
AGENCY_CHAT_CONCURRENCY=5
HEALTH_CHECK_INTERVAL_MINUTES=15
CONNECTION_TEST_TIMEOUT=10.0
HEALTH_DEGRADED_UPTIME_PCT=95.0
CONNECTION_LOG_BODY_MAX_CHARS=4096
CONNECTION_LOG_RETENTION_DAYS=90
EVAL_INTERVAL_HOURS=168

# ── Executive summary ──────────────────────────────────────────────────────
BRIEF_REGEN_INTERVAL_HOURS=24
WEEKLY_BRIEF_TIMEOUT=3600.0

# ── Popular questions ──────────────────────────────────────────────────────
POPULAR_QUESTIONS_REGEN_INTERVAL_HOURS=24
POPULAR_QUESTIONS_WINDOW_DAYS=30
POPULAR_QUESTIONS_MIN_TURNS=20
POPULAR_QUESTIONS_DISPLAY_COUNT=8

# ── Analytics windows ──────────────────────────────────────────────────────
AVG_LATENCY_WINDOW_DAYS=1
FEEDBACK_TREND_DAYS=14
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18

# ── Similarity cache ───────────────────────────────────────────────────────
SIMILARITY_THRESHOLD=0.95
SIMILARITY_WINDOW_SECONDS=60
SIMILARITY_CACHE_ENABLED=true
