# ──────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env for local dev.
#
# This file holds ONLY environment-level config: values that change between
# deploys (dev vs prod), secrets, and infra wiring that compose interpolates.
# Every var has a default in code (backend/app/config.py) or in compose.yaml
# (${VAR:-default}), so .env can be empty; set only what you must override.
#
# App-level tuning knobs (session times, chat/agency/analytics/similarity
# timeouts and windows, app identity) are NOT here. They keep one value across
# every deploy, so they live only as defaults in backend/app/config.py. You can
# still override any of them with a real env var if a specific deploy needs it —
# pydantic-settings reads it — but do not add them back to this file.
#
# Prod .env is generated by .github/workflows/release.yaml from secrets — no
# real secrets belong in this file.
#
# Tags:
#   [SET IN PROD]   default is dev-only or empty; production MUST override.
#   [SET IF NEEDED] default works in dev and prod; set for non-default behavior.
# ──────────────────────────────────────────────────────────────────────────

# ══════════════════════════════════════════════════════════════════════════
# [SET IN PROD] — production must override; dev works as-is.
# ══════════════════════════════════════════════════════════════════════════

# development | production. No code path enforces ENV; it is a passive label
# for logging/telemetry. CORS is wide-open by design (see CORS_ORIGINS).
ENV=development

# The only DB var the Python app reads. Default points at the compose postgres
# service. Prod: override with real credentials.
DATABASE_URL=postgres://chatbot:chatbot_secret@postgres:5432/chatbot

# JSON array. Default ["*"]: CORS is wide-open by design. Auth is an OIDC
# bearer token sent in the Authorization header (no cookies), so cross-site XHR
# cannot silently carry credentials. Set an explicit list like
# ["https://chatbotportal.opdc.ai.in.th"] to restrict.
CORS_ORIGINS=["*"]

# prod: set a real key. Empty = degraded mode (no AI features).
OPENROUTER_API_KEY=

# prod: override both. Defaults point at hardcoded staging IPs.
ONECHAT_BASE_URL=http://185.84.160.55:8000
MCP_ENDPOINT_URL=http://185.84.161.145/mcp/

# prod: set if parse-spec is used.
PARSE_SPEC_API_KEY=

# Public hostname for TLS. Empty = plain HTTP (local dev). Prod: your domain,
# e.g. chatbotportal.opdc.ai.in.th — Caddy auto-issues the cert.
CERT_DOMAIN=

# Let's Encrypt account contact for expiry notices. Prod: set a real email.
CERT_EMAIL=

# DEBUG | INFO | WARNING | ERROR. 15-Factor XI: stdout event-stream level.
# Dev often wants DEBUG; prod stays INFO.
LOG_LEVEL=INFO

# ── OIDC provider / IdP (self-hosted) ──────────────────────────────────────
# The backend IS the OpenID Provider (see MEMORY.md "Auth & RBAC"). It signs
# RS256 tokens with a key generated once and stored in the DB, verifies bearer
# tokens against its own JWKS, and stores accounts in the local `users` table.
#
# Password for the seeded first administrator (SEED_ADMIN_EMAIL, created only
# when no admin exists). Dev falls back to "admin"; prod MUST set a strong value.
SEED_ADMIN_PASSWORD=

# ══════════════════════════════════════════════════════════════════════════
# [SET IF NEEDED] — default works; set for non-default behavior.
# ══════════════════════════════════════════════════════════════════════════

# ── Gateway (compose caddy service) ───────────────────────────────────────
# 8080 = non-privileged local-dev port. Prod: 80 (Let's Encrypt HTTP-01 needs 80).
# IMPORTANT: this is the browser-facing origin, so it must stay in sync with
# OIDC_ISSUER below (http://localhost:<this port>) — the backend issues tokens
# under this origin and verifies the issuer against OIDC_ISSUER. If you run
# compose with NO .env, this defaults to a RANDOM host port and OIDC login will
# fail the issuer check; set a fixed free port here and match OIDC_ISSUER.
EXTERNAL_HTTP_PORT=8080
# Prod: 443. Dev is plain HTTP (CERT_DOMAIN unset), so unused locally.
EXTERNAL_HTTPS_PORT=
# Publish postgres on the host for local tooling. Prod: 5432 (or unset to hide).
EXTERNAL_POSTGRES_PORT=5432

# ── Database wiring (compose postgres service) ─────────────────────────────
# These build DATABASE_URL in compose.yaml. The backend reads only DATABASE_URL
# (above), not these four. Change if you want non-default creds.
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=chatbot_secret
POSTGRES_HOST=postgres

# ── OIDC provider (non-secret) ─────────────────────────────────────────────
# OIDC_ISSUER is the PUBLIC, browser-facing root origin. Discovery is served at
# {issuer}/.well-known/openid-configuration and the flow endpoints under
# {issuer}/oauth2/* by the backend through Caddy. It defines the token issuer,
# so it MUST match the origin the SPA logs in through. Dev = the Caddy host port
# (http://localhost:8080); prod = https://<domain>.
OIDC_ISSUER=http://localhost:8080
OIDC_CLIENT_ID=chatbotportal-web
OIDC_AUDIENCE=backend
# JSON array of redirect URIs the provider accepts (the SPA's /auth/callback).
# Prod: ["https://<domain>/auth/callback"].
OIDC_ALLOWED_REDIRECT_URIS=["http://localhost:8080/auth/callback"]
# Seeded first admin account (created only when no admin exists).
SEED_ADMIN_EMAIL=admin@chatbotportal.local
# The SPA (Vite) inlines its OIDC authority at BUILD time via a compose build-arg.
# It is the SAME public root-origin issuer as OIDC_ISSUER — keep them equal.
# Prod: set both to https://<domain> BEFORE building the frontend image.
VITE_OIDC_AUTHORITY=http://localhost:8080

# ── Frontend (Vite, build-time) ────────────────────────────────────────────
# Base URL of the backend API. Empty = same-origin (Caddy proxies /api).
# Note: Vite inlines VITE_* at BUILD time, so this only affects the dev server
# (compose.override.yaml) — the prod static bundle always uses same-origin.
VITE_API_BASE_URL=
# "true" enables MSW request mocking (dev/test only).
VITE_USE_MOCKS=
